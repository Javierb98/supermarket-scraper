[Unit]
Description=Weekly supermarket price run

[Timer]
# Monday mornings, early, with a random delay so the chains do not see a
# request at exactly the same second every week from the same address.
#
# Weekly buys freshness, and only freshness. It does NOT make the averages
# any thicker: market_average counts one day's scrape, so running four times
# a month gives four snapshots of the same size, not one snapshot four times
# the size. What a product needs to clear the site's five-price minimum is
# more chains and more postcodes, not more often.
#
# What weekly is worth: fresh produce genuinely reprices week to week — the
# European Commission publishes these prices weekly for that reason — and a
# missed run costs seven days instead of thirty.
OnCalendar=Mon *-*-* 04:00:00
RandomizedDelaySec=2h

# The reason this is a timer and not a crontab line.
#
# cron only fires if the machine happens to be awake at the appointed minute.
# This one is at home: it loses power, it gets unplugged, the router reboots.
# Every one of those used to mean a month silently missing.
#
# Persistent records when the run was last due. If the Pi was off, the run
# starts as soon as it comes back rather than waiting for next month.
Persistent=true

[Install]
WantedBy=timers.target
